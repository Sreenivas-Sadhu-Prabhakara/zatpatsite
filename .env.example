# ZatpatSite configuration — everything runs with zero keys by default.

# HTTP port (default 8104)
PORT=8104

# Google Business Profile provider.
#   mock (default): deterministic offline profiles seeded from an FNV hash of
#                   business name + city. Same input, same profile, always.
#   live:           would call the Google Places API. Not built in this MVP —
#                   the server logs a notice and falls back to mock.
GBP_PROVIDER=mock

# Required only when GBP_PROVIDER=live is implemented.
GOOGLE_PLACES_API_KEY=
